{
  "name": "student-agent",
  "description": "A CLI coding agent with memory, self-reflection, and an honest eval harness",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "student-agent": "./bin/student-agent"
  },
  "scripts": {
    "dev": "STUDENT_AGENT_TUI=v2 bun src/extension/index.ts",
    "dev:v1": "STUDENT_AGENT_TUI=v1 bun src/extension/index.ts",
    "dev:v2": "STUDENT_AGENT_TUI=v2 bun src/extension/index.ts",
    "build": "tsc",
    "eval:validate": "npx tsx scripts/eval-validate.ts",
    "eval:baseline": "npx tsx scripts/eval-baseline.ts",
    "eval:claude-code": "npx tsx scripts/eval-claude-code.ts",
    "eval:context-runtime": "npx tsx scripts/eval-context-runtime.ts",
    "eval:jspace-recovery": "npx tsx scripts/eval-jspace-recovery-runner.ts",
    "eval:webui:report": "npx tsx scripts/eval-webui-report.ts",
    "eval:terminal-bench": "npx tsx scripts/eval-terminal-bench.ts",
    "eval:swebench": "npx tsx scripts/eval-swebench.ts",
    "eval:swebench:produce": "npx tsx scripts/eval-swebench-produce.ts",
    "eval:injection": "npx tsx scripts/eval-injection-experiment.ts",
    "eval:injection:score": "npx tsx scripts/eval-injection-score.ts",
    "eval:injection:midterm": "npx tsx scripts/eval-injection-midterm.ts",
    "eval:recall:reconcile": "npx tsx scripts/reconcile-recall-credit.ts",
    "chronicle:build": "npx tsx scripts/build-chronicle-graph.ts",
    "import:locobench-agent": "npx tsx scripts/import-locobench-agent.ts",
    "eval:locobench-agent:official": "npx tsx scripts/eval-locobench-agent-official.ts",
    "eval:locobench-agent:unified": "npx tsx scripts/eval-locobench-agent-unified.ts",
    "eval:locobench-agent:deepseek": "bash scripts/run-locobench-unified-deepseek.sh",
    "eval:comparison:deepseek": "python3 scripts/run_benchmark_comparison.py",
    "score:locobench-agent": "npx tsx scripts/score-locobench-agent.ts",
    "score:locobench-agent:official": "npx tsx scripts/score-locobench-agent-official.ts",
    "test": "vitest",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^0.78.1",
    "@mariozechner/pi-agent-core": "0.73.1",
    "@mariozechner/pi-ai": "0.73.1",
    "@mariozechner/pi-coding-agent": "0.73.1",
    "@mozilla/readability": "^0.6.0",
    "@oh-my-pi/hashline": "^15.9.67",
    "@opentui/core": "^0.3.2",
    "@opentui/solid": "^0.3.2",
    "better-sqlite3": "^12.9.0",
    "chalk": "^5.6.2",
    "ink": "^5.2.1",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "ora": "^9.4.0",
    "p-queue": "^9.2.0",
    "playwright": "^1.59.1",
    "react": "^18.3.1",
    "simple-git": "^3.25.0",
    "solid-js": "^1.9.12",
    "sqlite-vec": "^0.1.9",
    "string-width": "^7.2.0",
    "tsx": "^4.22.4",
    "turndown": "^7.2.4",
    "xstate": "^5.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.28",
    "@types/turndown": "^5.0.6",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "vitest": "4.1.10",
    "xxhash": "^0.3.0"
  }
}
