# Student Agent local environment.
# Copy to .env and fill values locally. Do not commit real secrets.

# Anthropic-compatible relay / proxy.
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=

# OpenAI Chat Completions-compatible provider.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Optional. Context7 anonymous access works with quota, but a key can raise limits.
CONTEXT7_API_KEY=

# Optional. OpenAI-compatible embedding model for docs-index.
STUDENT_AGENT_EMBEDDING_BASE_URL=https://work.poloapi.com/v1
STUDENT_AGENT_EMBEDDING_MODEL=text-embedding-3-small
STUDENT_AGENT_EMBEDDING_API_KEY=

# Optional runtime config overrides.
# Defaults can also be configured in .student-agent.json.
STUDENT_AGENT_CONFIG=.student-agent.json
STUDENT_AGENT_ENV_FILE=.env
STUDENT_AGENT_PROVIDER=anthropic
STUDENT_AGENT_MODEL=claude-sonnet-4-6
STUDENT_AGENT_MODEL_BASE_URL=
STUDENT_AGENT_LLM_REQUEST_TIMEOUT_MS=300000
STUDENT_AGENT_LLM_MAX_OUTPUT_TOKENS=
STUDENT_AGENT_LLM_MAX_RETRIES=
STUDENT_AGENT_LLM_MAX_RETRY_DELAY_MS=60000
STUDENT_AGENT_SUPPRESS_EMBEDDING_REMINDER=false
STUDENT_AGENT_FEATURE_CONTEXT7=true
STUDENT_AGENT_FEATURE_PLAYWRIGHT=false
STUDENT_AGENT_FEATURE_DESIGN_STUDY=true
STUDENT_AGENT_FEATURE_BOUNDED_BREAKER=true
STUDENT_AGENT_FEATURE_QUALITY_WATCHDOG=true
STUDENT_AGENT_FEATURE_SUB_AGENTS=false

# Optional Design Study / Visual Style Learner.
STUDENT_AGENT_DESIGN_EXTRACTOR_MODE=auto
STUDENT_AGENT_DESIGN_DEMBRANDT_COMMAND=
STUDENT_AGENT_DESIGN_CRITIC_THRESHOLD=0.8
STUDENT_AGENT_DESIGN_MAX_CRITIC_RETRIES=1
STUDENT_AGENT_DESIGN_LOCAL_URL=
